---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Herramientas Potrero — Calculadoras ganaderas',
  description = 'Suite de calculadoras ganaderas gratuitas para productores de Bolivia. Ágio, carga animal, punto de equilibrio, suplementación y más. Todo en Bs.',
} = Astro.props

const BASE = import.meta.env.BASE_URL
const ogImage = `${BASE}brand/isotipo-color.png`.replace(/\/+/g, '/')
const favicon = `${BASE}favicon.png`.replace(/\/+/g, '/')
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1E4230" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_BO" />
    <meta property="og:image" content={ogImage} />
    <link rel="icon" type="image/png" href={favicon} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
