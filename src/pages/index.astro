---
import Layout from '@/layouts/Layout.astro'

const BASE    = import.meta.env.BASE_URL
const logoSrc = `${BASE}brand/isotipo-color.png`.replace(/\/+/g, '/')
const WA      = 'https://wa.me/59177423154?text=Hola%20Potrero%2C%20quiero%20saber%20m%C3%A1s'
const p = (path: string) => `${BASE}${path}`.replace(/\/+/g, '/').replace(/([^:])\/\//g, '$1/')

const herramientas = [
  {
    title: 'Simulador de Negocios',
    desc:  'Evaluá una compra antes de hacerla: cuánto podés pagar, a qué precio vender y en cuánto tiempo. Guardá y compará hasta 5 escenarios.',
    badge: 'Popular', badgeClass: 'badge-popular', iconBg: '#DCFCE7',
    href: p('simulador/'), available: true,
    svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
  },
  {
    title: 'Diluir Ágio',
    desc:  'Calculá cuántos días necesitás para diluir el sobreprecio pagado en la compra de animales.',
    badge: 'Nuevo', badgeClass: 'badge-nuevo', iconBg: '#DBEAFE',
    href: p('diluir-agio/'), available: true,
    svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
  },
  {
    title: 'Carga Animal',
    desc:  'Calculá la carga animal en UA/ha y kg/ha. Ingresá tu rodeo por categorías y optimizá el uso de tus potreros.',
    badge: 'Nuevo', badgeClass: 'badge-nuevo', iconBg: '#FEF9C3',
    href: p('carga-animal/'), available: true,
    svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#CA8A04" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  },
  {
    title: 'Cálculo de Suplementación',
    desc:  'Determiná la cantidad exacta de suplemento necesario para tu rebaño por día.',
    badge: 'Nuevo', badgeClass: 'badge-nuevo', iconBg: '#FEE2E2',
    href: p('suplementacion/'), available: true,
    svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg>`,
  },
  {
    title: 'Punto de Equilibrio',
    desc:  'Calculá el precio mínimo de venta en Bs/kg para no tener pérdidas en tu operación.',
    badge: 'Nuevo', badgeClass: 'badge-nuevo', iconBg: '#EDE9FE',
    href: p('punto-equilibrio/'), available: true,
    svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7C3AED" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><path d="M8 5l-3 7 3 7"/><path d="M16 5l3 7-3 7"/></svg>`,
  },
  {
    title: 'Cálculo de la Diaria',
    desc:  'Calculá el costo operativo diario por cabeza y el margen por kg producido.',
    badge: 'Próximamente', badgeClass: 'badge-prox', iconBg: '#DCFCE7',
    href: null, available: false,
    svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  },
  {
    title: 'Costo de Producción PRO',
    desc:  'Descubrí cuánto te cuesta producir cada kg con base en costos mensuales y GMD.',
    badge: 'Próximamente', badgeClass: 'badge-prox', iconBg: '#FFEDD5',
    href: null, available: false,
    svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#EA580C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`,
  },
  {
    title: 'Simulación de Compra',
    desc:  'Compará distintas opciones de compra de ganado y encontrá la mejor inversión.',
    badge: 'Próximamente', badgeClass: 'badge-prox', iconBg: '#DBEAFE',
    href: null, available: false,
    svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>`,
  },
  {
    title: 'Apuración Anual',
    desc:  'Consolidá receitas, costos y gastos anuales con análisis completo de rentabilidad.',
    badge: 'Próximamente', badgeClass: 'badge-prox', iconBg: '#F3E8FF',
    href: null, available: false,
    svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#9333EA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    title: 'Cierre de Lote',
    desc:  'Calculá el rendimiento de carcasa y el resultado final estimado de la venta.',
    badge: 'Próximamente', badgeClass: 'badge-prox', iconBg: '#FEE2E2',
    href: null, available: false,
    svg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
  },
]
---

<Layout
  title="Herramientas Potrero — Calculadoras ganaderas gratuitas"
  description="Suite de calculadoras ganaderas gratuitas para productores de Bolivia. Ágio, carga animal, punto de equilibrio, suplementación y más. Todo en Bs."
>
<div class="min-h-screen bg-[#F5F5F5] font-sans">

  {/* ── HEADER ── */}
  <header class="bg-[#1E4230] text-white px-5 py-4 shadow-md">
    <div class="max-w-5xl mx-auto flex items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        <img src={logoSrc} alt="Potrero" class="w-8 h-8 object-contain" />
        <div>
          <p class="font-display font-medium text-[1.1rem] leading-none tracking-tight">Potrero</p>
          <p class="text-earth-500 text-[10px] leading-none mt-0.5">Gestión ganadera · Bolivia</p>
        </div>
      </div>
      <a href={WA} target="_blank" rel="noopener noreferrer"
        class="flex items-center gap-1.5 text-xs font-semibold bg-[#25D366] hover:bg-[#1faf54] text-white px-3 py-2 rounded-lg transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        WhatsApp
      </a>
    </div>
  </header>

  {/* ── HERO ── */}
  <div class="bg-[#1E4230] text-white px-5 pt-5 pb-8 border-t border-[#163527]">
    <div class="max-w-5xl mx-auto">
      <p class="text-[#C8A971] text-xs font-bold uppercase tracking-widest mb-2">Potrero · Suite gratuita</p>
      <h1 class="font-display font-medium text-[1.7rem] md:text-[2.2rem] tracking-tight leading-tight">
        Calculadoras ganaderas
      </h1>
      <p class="text-earth-300/70 text-sm mt-1.5 max-w-lg">
        10 herramientas gratuitas para productores · Todo en <strong class="text-earth-300">Bs</strong> · Sin registro
      </p>
    </div>
  </div>

  {/* ── GRID ── */}
  <main class="max-w-5xl mx-auto px-4 py-6 md:py-8">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {herramientas.map((h) => (
        <div class={`relative bg-white rounded-2xl border overflow-hidden transition-all duration-200 ${
          h.available
            ? 'border-gray-200 hover:border-gray-300 hover:shadow-md cursor-pointer group'
            : 'border-gray-200 opacity-55'
        }`}>
          {h.available ? (
            <a href={h.href!} class="block p-5">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 transition-transform duration-200 group-hover:scale-105"
                style={`background-color:${h.iconBg}`}>
                <Fragment set:html={h.svg} />
              </div>
              <h2 class="font-bold text-gray-900 text-[0.95rem] leading-snug mb-1.5 group-hover:text-[#1E4230] transition-colors">{h.title}</h2>
              <p class="text-gray-500 text-xs leading-relaxed mb-3">{h.desc}</p>
              <span class={`inline-block text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wide ${h.badgeClass}`}>{h.badge}</span>
            </a>
          ) : (
            <div class="p-5">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style={`background-color:${h.iconBg}`}>
                <Fragment set:html={h.svg} />
              </div>
              <h2 class="font-bold text-gray-900 text-[0.95rem] leading-snug mb-1.5">{h.title}</h2>
              <p class="text-gray-500 text-xs leading-relaxed mb-3">{h.desc}</p>
              <span class={`inline-block text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wide ${h.badgeClass}`}>{h.badge}</span>
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="mt-8 bg-[#1E4230]/5 border border-[#1E4230]/10 rounded-2xl px-5 py-4 flex flex-col sm:flex-row items-start sm:items-center gap-3 justify-between">
      <div>
        <p class="font-semibold text-[#1E4230] text-sm">¿Querés sugerir una herramienta?</p>
        <p class="text-gray-500 text-xs mt-0.5">Estamos construyendo esto con productores — tu feedback vale.</p>
      </div>
      <a href={WA} target="_blank" rel="noopener noreferrer"
        class="shrink-0 flex items-center gap-2 bg-[#25D366] hover:bg-[#1faf54] text-white text-xs font-bold px-4 py-2.5 rounded-xl transition-colors">
        Escribinos
      </a>
    </div>

    <p class="text-center text-xs text-gray-400 mt-6">
      Potrero © {new Date().getFullYear()} · Herramientas gratuitas para productores de Bolivia 🇧🇴
    </p>
  </main>
</div>
</Layout>

<style>
  .badge-popular { background:#DCFCE7; color:#15803D; }
  .badge-nuevo   { background:#FEF9C3; color:#854D0E; }
  .badge-prox    { background:#F3F4F6; color:#6B7280; }
</style>
